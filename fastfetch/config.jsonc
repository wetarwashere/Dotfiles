{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$HOME/.config/fastfetch/crayon.png",
    "type": "kitty",
    "height": 18,
    "width": 40,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4,
      "bottom": 0
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[97m───────────────────System───────────────────"
    },
    "break",
    {
      "type": "host",
      "key": "   PC",
      "format": "{family}",
      "keyColor": "white"
    },
    {
      "type": "display",
      "key": "  󰍹 Monitor",
      "format": "{width}x{height} [{refresh-rate}hz]",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "format": "{name}",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "key": "   GPU",
      "format": "{name}",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "   Memory",
      "format": "{used} / {total}",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": "   Disk",
      "format": "{size-used} / {size-total} [{filesystem} on {mountpoint}]",
      "keyColor": "white"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[97m────────────────────User────────────────────"
    },
    "break",
    {
      "type": "os",
      "key": "   Distro",
      "format": "{name}",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "  󰞸 Kernel",
      "format": "{release}",
      "keyColor": "white"
    },
    {
      "type": "users",
      "key": "   User",
      "format": "{1}",
      "keyColor": "white"
    },
    {
      "type": "media",
      "key": "   Music",
      "format": "{title} - {artist}",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "   Window Manager",
      "format": "{pretty-name}",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "   Protocol",
      "format": "{protocol-name}",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "format": "{pretty-name}",
      "keyColor": "white"
    },
    {
      "type": "shell",
      "key": "   Shell",
      "format": "{pretty-name}",
      "keyColor": "white"
    },
    "break",
    {
      "type": "colors",
      "symbol": "square",
      "paddingLeft": 13
    }
  ]
}
